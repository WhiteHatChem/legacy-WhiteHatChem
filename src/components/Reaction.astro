---
import { CompoundName, CompoundNameList } from './compound';
import type { Reaction } from '../common/types'
import { getLangFromUrl, i18n_href, useTranslations } from '../i18n/i18n';

interface Props {
  reaction: Reaction;
  reaction_type: 'anterior' | 'posterior'
}

const { reaction, reaction_type } = Astro.props;
const { reaction_name, reaction_id, enzymes, inchi, sources, _id } = reaction;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<span class="flex flex-col lg:flex-row justify-between border dark:border-neutral-800 bg-neutral-200/20 dark:bg-neutral-800/20 rounded p-2 text-sm leading-tight">
    <div>
      <div class="mb-1"><span class="underline">{reaction_name}</span> <span class="rounded-lg px-1 bg-indigo-500 text-white ml-2 text-xs">{reaction_id}</span></div>
      <div> {t('reaction.enzymes')}: <span class="text-neutral-600 dark:text-neutral-400">{reaction.enzymes.split('\n').join(', ')}</span></div> 
    </div>
    <div class="flex lg:flex-col justify-between items-center lg:items-end mt-2 lg:mt-0">
      <span class="font-bold text-indigo-900 dark:text-indigo-100 mb-2">{reaction_type === 'anterior' ? 'Reagents' : 'Products'}</span>
      <div class="flex flex-row items-center">
        {(_id !== undefined && sources !== undefined) ? <a
          href={i18n_href(`/compound/${_id}`, lang)}
          class="group flex flex-col gap-1 items-end"
        >
          <CompoundNameList src={sources}/>
        </a> : <CompoundName name={inchi} metabolite={true} site='none' />}
      </div> 
    </div>
</span>
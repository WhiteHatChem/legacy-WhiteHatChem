---
import CompoundName from './compound_id/CompoundName.astro';
import type { Reaction } from '../common/types'
import { getLangFromUrl, i18n_href, useTranslations } from '../i18n/i18n';
import CompoundNameList from './compound_id/CompoundNameList.astro';

interface Props {
  reaction: Reaction;
}

const { reaction } = Astro.props;
const x = reaction.product;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<span class="border dark:border-neutral-600 rounded p-2 text-sm leading-tight">
    <div class="underline">{reaction.name}</div>
    <div class="flex flex-row items-center">
        {t('reaction.product')}: {x.toxic || x.metabolite ? <span class="flex flex-row gap-2 items-center justify-between min-h-16 p-2">
            {(x.hsdb_names && x.hsdb_names.length > 0) ?
                x.hsdb_names.map((name, i) => <a href={`https://pubchem.ncbi.nlm.nih.gov/compound/${x.cid![i]}`} target="_blank">
                    <CompoundName toxic={x.toxic} metabolite={x.metabolite} name={name} site="pubchem"/>
                </a>)
            :(x.cid && x.cid.length > 0) ?
                x.cid.map((cid, i) => <a href={`https://pubchem.ncbi.nlm.nih.gov/compound/${cid}`} target="_blank">
                    <CompoundName toxic={x.toxic} metabolite={x.metabolite} name={x.inchi} site="pubchem"/>
                </a>)
            : <CompoundName name={x.inchi} site="none"/>}
        </span> : <a
            href={i18n_href(`/molecule/${x._id}`, lang)}
            class="group flex flex-row gap-2 items-center justify-between min-h-16 rounded p-2"
        >
            <CompoundNameList data={x} />
        </a>}
    </div> 
    <div> {t('reaction.enzymes')}: <span class="text-neutral-600 dark:text-neutral-400">{reaction.enzymes.join(', ')}</span></div> 
</span>
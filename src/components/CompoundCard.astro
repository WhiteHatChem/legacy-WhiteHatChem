---
import ComponentSvg from './ComponentSvg.astro'
import CompoundName from './CompoundName.astro';
import type { MoleculeData } from '../common/types';
import { getLangFromUrl, i18n_href } from '../i18n/i18n';

const { psychonaut_names, tripsit_names, isomerd_names, hsdb_names, name, svg } = Astro.props as MoleculeData;
const lang = getLangFromUrl(Astro.url);
---

<a
    href={i18n_href(`/molecule/${name}`, lang)}
    class="flex flex-col items-center group"
>
    <div class="flex flex-col">
        {psychonaut_names && psychonaut_names.map(name => <CompoundName name={name} site="psychonaut"/>)}
        {tripsit_names && tripsit_names.map(name => <CompoundName name={name} site="tripsit"/>)}
        {isomerd_names && isomerd_names.map(name => <CompoundName name={name} site="isomerdesign"/>)}
        {hsdb_names && hsdb_names.map(name => <CompoundName name={name} site="pubchem"/>)}
    </div>
    <div class="w-full border-t border-neutral-400/20 dark:border-neutral-600 mt-2 group-hover:border-indigo-400/50 dark:group-hover:border-indigo-400"/>
    <ComponentSvg svg={svg} name={name.toString()}/>
</a>
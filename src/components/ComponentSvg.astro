---
export interface Props {
	name: string;
    svg: string
}

const { name, svg } = Astro.props;
---

{
    svg ? <img
        src={`/svg/${svg}`}
        alt={`depiction of ${name}`}
        loading="lazy"
    > : <span class="text-sm font-light text-red-400 my-auto">
        img not found
    </span>
}

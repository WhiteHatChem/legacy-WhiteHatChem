---
import CompoundName from './CompoundName.astro';
import { useTranslations, getLangFromUrl } from '../i18n/i18n'

export interface Props {
    names: string[] | null;
    ids: number[] | null;
    site: 'psychonaut' | 'tripsit' | 'isomerdesign' | 'pubchem';
}

const { names, ids, site } = Astro.props;

const getLink = (site: string, name: string, id: number | null) => {
  switch (site) {
    case 'psychonaut':
      return `https://psychonautwiki.org/wiki/${name}`;
    case 'tripsit':
      return `https://drugs.tripsit.me/${name}`
    case 'isomerdesign':
      return `https://isomerdesign.com/PiHKAL/explore.php?id=${id}`;
    case 'pubchem':
      return `https://pubchem.ncbi.nlm.nih.gov/compound/${id}`;
  }
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---


{
  names && names.map((name, idx) => <a class="flex flex-col lg:flex-row lg:items-center" href={getLink(site, name, ids ? ids[idx] : null)} target="_blank">
      <CompoundName name={name} site={site}/>
      <p class="text-sm text-neutral-400 dark:text-neutral-400 flex flex-row items-center gap-2 lg:ml-2">
          {t('molecule.checkon')} {site}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-sm text-neutral-400 dark:text-neutral-600">
              <path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 015.25 2h5.5A2.25 2.25 0 0113 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75h-5.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 00.75-.75v-2a.75.75 0 011.5 0v2A2.25 2.25 0 0110.75 18h-5.5A2.25 2.25 0 013 15.75V4.25z" clip-rule="evenodd" />
              <path fill-rule="evenodd" d="M6 10a.75.75 0 01.75-.75h9.546l-1.048-.943a.75.75 0 111.004-1.114l2.5 2.25a.75.75 0 010 1.114l-2.5 2.25a.75.75 0 11-1.004-1.114l1.048-.943H6.75A.75.75 0 016 10z" clip-rule="evenodd" />
          </svg>
      </p>
  </a>)
}
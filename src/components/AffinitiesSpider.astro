---
export interface Props {
  data: { site: string; value: number;}[];
  key: string;
}

const { data, key } = Astro.props;
---
<style>
    spider-chart {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>

<script>
    class Spider extends HTMLElement {
        constructor() {
            super();
            this.data = [];
            this.canvas = document.createElement('canvas');
            this.appendChild(this.canvas);
        }

        connectedCallback() {
            this.parseDataAttribute();
            this.renderChart();
        }

        parseDataAttribute() {
            const dataAttribute = this.getAttribute('data');
            if (dataAttribute) {
                this.data = JSON.parse(dataAttribute);
            }
        }

        renderChart() {
            const labels = this.data.map(item => item.site);
            const values = this.data.map(item => item.value);

            const ctx = this.canvas.getContext('2d');
            new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        fill: true,
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        pointBackgroundColor: 'rgba(75, 192, 192, 1)',
                        pointBorderColor: '#fff',
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: 'rgba(75, 192, 192, 1)',
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        r: {
                            min: 0,
                            max: 1,
                            ticks: {
                                stepSize: 0.25,
                            },
                            angleLines: {
                                color: 'rgba(127, 127, 127, 0.2)'
                            },
                            grid: {
                                color: 'rgba(127, 127, 127, 0.2)'
                            },
                        }
                    }
                }
            });
        }
    }
    // Define the custom element
    customElements.define("spider-chart", Spider);
</script>

<spider-chart data={JSON.stringify(data)} />
---
export interface Props {
  sim: number;
}

const { sim } = Astro.props;

const green = Math.round(255 * sim);
const red = Math.round(255 * (1-sim));
---

<span class="flex items-center w-full lg:w-min">
  <p class="text-sm text-neutral-600 dark:text-neutral-400 text-sm mr-2">{`${(Math.round(sim * 1000) / 10).toFixed(1)}%`}</p>
  <div class="w-full lg:w-60 h-5 bg-neutral-200 dark:bg-neutral-700 rounded border border-neutral-300 dark:border-neutral-600 overflow-hidden">
      <div
          class="h-full rounded text-xs"
          style={{
              width: `${100 * sim}%`,
              backgroundColor: `rgb(${red}, ${green}, 0)`,
          }}
      />
  </div>
</span>
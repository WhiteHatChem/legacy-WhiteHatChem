---
import { getLangFromUrl, languages } from '../i18n/i18n';

const lang = getLangFromUrl(Astro.url);
---
<script>
    function onchange_handler(e: any) {
        const newLang = e.currentTarget.value;
        const [_leadingSlash, _oldLang, ...rest] = window.location.pathname.split('/');
        const slug = rest.join('/');
        window.location.pathname = `/${newLang}/${slug}`;
    }
    const select_list = document.querySelectorAll('#lang-select')!;
    for (const select of select_list) {
        select.addEventListener('change', onchange_handler);
    }
</script>

<label
    for="lang-select"
    class="relative flex flex-row items-center
    rounded-xl transition duration-150
    hover:bg-indigo-100 dark:hover:bg-neutral-700
    active:bg-indigo-200 
    hover:text-neutral-800 dark:hover:text-neutral-200
    text-neutral-600 dark:text-neutral-400"
>
    <svg class="absolute left-3 w-6 h-6 z-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-languages"><path d="m5 8 6 6"></path><path d="m4 14 6-6 2-3"></path><path d="M2 5h12"></path><path d="M7 2h1"></path><path d="m22 22-5-10-5 10"></path><path d="M14 18h6"></path></svg>
    <select
        class="bg-transparent cursor-pointer z-[1]
        lg:w-full lg:text-current lg:py-2 lg:pr-1 lg:mr-2 lg:pl-11
        text-transparent w-12 py-2"
        name="lang"
        id="lang-select"
    >
        {
            Object.entries(languages).map(([key, value]) => {
                return <option class="text-black" value={key} selected={key === lang}>
                    {value}
                </option>
            })
        }
    </select>
</label>
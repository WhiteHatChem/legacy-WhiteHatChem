---
import CompoundName from './compound_id/CompoundName.astro';
import PercentBar from './PercentBar.astro';
import type { SimilarMolecule } from '../common/types';
import { getLangFromUrl, i18n_href } from '../i18n/i18n';
import CompoundNameList from './compound_id/CompoundNameList.astro';
import CompoundNameLink from './compound_id/CompoundNameLink.astro';
import CompoundNameLinks from './compound_id/CompoundNameLinks.astro';

export interface Props {
  sim: Array<SimilarMolecule>,
  filter: (x: number) => number
}

const { sim, filter } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
---


<div class="flex flex-col mt-4 gap-2">
  { sim.sort((a,b) => (filter(b.dist) - filter(a.dist))).map((x) => {
      const sim = filter(x.dist);
      const { id, dist } = x;
      return (
        !id.search ? <div class="group flex lg:flex-row flex-col gap-2 items-center justify-between min-h-16 border dark:border-neutral-600 rounded p-2">
            <div class="flex flex-col">
              <CompoundNameLinks id={id} />
            </div>
            <PercentBar sim={sim}/>
        </div> : <a
          href={i18n_href(`/molecule/${id.name}`, lang)}
          class="group flex lg:flex-row flex-col gap-2 items-center justify-between min-h-16 border dark:border-neutral-600 rounded p-2"
        >
          <div class="flex flex-col">
            <CompoundNameList id={id} />
          </div>
          <PercentBar sim={sim}/>
        </a> 
      )
  })}
</div>
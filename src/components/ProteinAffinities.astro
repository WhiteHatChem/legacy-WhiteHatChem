---
import AffinitiesSpider from './AffinitiesSpider.astro';
export interface Props {
  embedding: Array<number>
}

const DOCKING_SITES = [
  'AF-A5X5Y0-F1-model_v1_box_0', 'AF-A5X5Y0-F1-model_v1_box_2',
  'AF-A5X5Y0-F1-model_v1_box_3', 'AF-A5X5Y0-F1-model_v1_box_4',
  'AF-O95264-F1-model_v1_box_2', 'AF-O95264-F1-model_v1_box_3',
  'AF-P08588-F1-model_v1_box_1', 'AF-P08588-F1-model_v1_box_2',
  'AF-P08588-F1-model_v1_box_5', 'AF-P08908-F1-model_v1_box_0',
  'AF-P08908-F1-model_v1_box_10', 'AF-P08908-F1-model_v1_box_2',
  'AF-P08908-F1-model_v1_box_3', 'AF-P08908-F1-model_v1_box_4',
  'AF-P08908-F1-model_v1_box_7', 'AF-P13945-F1-model_v1_box_1',
  'AF-P13945-F1-model_v1_box_3', 'AF-P13945-F1-model_v1_box_6',
  'AF-P13945-F1-model_v1_box_8', 'AF-P18089-F1-model_v1_box_1',
  'AF-P18089-F1-model_v1_box_2', 'AF-P18089-F1-model_v1_box_3',
  'AF-P18089-F1-model_v1_box_5', 'AF-P21728-F1-model_v1_box_10',
  'AF-P21728-F1-model_v1_box_4', 'AF-P21728-F1-model_v1_box_9',
  'AF-P21918-F1-model_v1_box_4', 'AF-P21918-F1-model_v1_box_6',
  'AF-P21918-F1-model_v1_box_8', 'AF-P25100-F1-model_v1_box_11',
  'AF-P25100-F1-model_v1_box_12', 'AF-P25100-F1-model_v1_box_3',
  'AF-P25100-F1-model_v1_box_5', 'AF-P25100-F1-model_v1_box_6',
  'AF-P25100-F1-model_v1_box_8', 'AF-P28221-F1-model_v1_box_0',
  'AF-P28221-F1-model_v1_box_1', 'AF-P28221-F1-model_v1_box_2',
  'AF-P28221-F1-model_v1_box_3', 'AF-P28566-F1-model_v1_box_2',
  'AF-P46098-F1-model_v1_box_5', 'AF-P46098-F1-model_v1_box_7',
  'AF-Q9Y2T6-F1-model_v1_box_3', 'P08913_6KUX_A_box_0',
  'P08913_6KUX_A_box_1', 'P14416_6CM4_A_box_0', 'P14416_6CM4_A_box_6',
  'P18825_6KUW_A_box_0', 'P18825_6KUW_A_box_1', 'P21917_5WIU_A_box_0',
  'P21917_5WIU_A_box_2', 'P28222_4IAR_A_box_0', 'P28222_4IAR_A_box_1',
  'P28223_6WGT_C_box_2', 'P28223_6WGT_C_box_4', 'P28335_6BQH_A_box_0',
  'P28335_6BQH_A_box_2', 'P28335_6BQH_A_box_5', 'P35462_3PBL_A_box_0',
  'P35462_3PBL_A_box_3', 'P41595_4IB4_A_box_0'
]

const { embedding } = Astro.props as Props;
const affinities = DOCKING_SITES.map((x, i) => [x, embedding[i]] as const);

console.log(embedding.length, DOCKING_SITES.length);

// Group affinities by protein prefix
const grouped_affinities = affinities.reduce((acc, [key, value]) => {
    let protein = '';
    let docking_site = '';
    let score = value;

    if (key[0] === 'A') {
        protein = key.split('-').slice(0, 2).join('-');
        docking_site = key.split('-').slice(-1)[0];
    } else if (key[0] === 'P' || key[0] === 'Q') {
        protein = key.split('_').slice(0, 2).join('_');
        docking_site = key.split('_').slice(-1)[0];
    }
    if (!acc[protein]) {
        acc[protein] = [];
    }
    acc[protein].push({ site: docking_site, value: score });
    return acc;
}, {} as { [key: string]: { site: string; value: number }[] });

console.log(grouped_affinities)
const protein2url = (protein : string) => {
  const docking_type = protein[0];
  const id = docking_type === 'P' ? protein.split('_')[1] : protein.split('-')[1];
  const url = docking_type === 'A' ? `https://alphafold.ebi.ac.uk/entry/${id}` : `https://www.rcsb.org/structure/${id}`;
  return url;
} 
---

<div class="flex flex-col mt-4 gap-2">
    { Object.entries(grouped_affinities).map(([protein, sites_data]) => {
        return (
        <div class="group flex lg:flex-row flex-col gap-2 lg:items-center items-start justify-between min-h-16 border dark:border-neutral-600 rounded p-2">
            <a href={protein2url(protein)} target="_blank" class="flex flex-row gap-2">
                <svg
                class="w-5 text-neutral-600 dark:text-neutral-400"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                >
                <path d="M2 15c6.667-6 13.333 0 20-6"></path><path d="M9 22c1.798-1.998 2.518-3.995 2.807-5.993"></path><path d="M15 2c-1.798 1.998-2.518 3.995-2.807 5.993"></path><path d="m17 6-2.5-2.5"></path><path d="m14 8-1-1"></path><path d="m7 18 2.5 2.5"></path><path d="m3.5 14.5.5.5"></path><path d="m20 9 .5.5"></path><path d="m6.5 12.5 1 1"></path><path d="m16.5 10.5 1 1"></path><path d="m10 16 1.5 1.5"></path>
                </svg>
                {protein}
            </a>
            <div class="flex flex-col items-center w-full max-w-md">
                <div class="flex flex-row flex-wrap gap-2">
                    {
                        sites_data.map(data => {
                            const { site, value } = data;
                            return <div
                                class="w-5 h-5 rounded-md overflow-hidden flex items-end bg-neutral-200 dark:bg-neutral-700 border border-neutral-300 dark:border-neutral-600"
                                title={`Docking site ${site}: ${(100. * value).toFixed(1)}%`}
                            >
                                <div
                                    class="w-full bg-green-400 dark:bg-green-500"
                                    style={{
                                        height: `${100 * value}%`,
                                    }}
                                />
                            </div>
                        })
                    }
                </div>
                { sites_data.length > 2 && <AffinitiesSpider data={sites_data} key={protein}/> }
            </div>
        </div>
        )
    })}
</div>
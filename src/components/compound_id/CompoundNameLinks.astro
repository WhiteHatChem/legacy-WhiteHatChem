---
// List all compound external links 
import type { MoleculeIdentifier } from '../../common/types';
import CompoundName from './CompoundName.astro';
import CompoundNameLink from './CompoundNameLink.astro';

interface Props {
    id: MoleculeIdentifier;
}

const { id } = Astro.props;

const {
  inchi, name,
  psychonaut_names,
  tripsit_names,
  isomerd_names,
  isod_ids,
  druglab_names, druglab_href,
  drugmap_name, drugmap_id,
  hsdb_names, cid,
  search, toxic, metabolite,
} = id;

const nosite = (psychonaut_names === null && tripsit_names === null && isomerd_names === null && druglab_names === null && hsdb_names === null && drugmap_name === null);
---

{ nosite ? 
    <CompoundName site='none' name={inchi} toxic={toxic} />
    : <>
        <CompoundNameLink names={tripsit_names} ids={null} site={'tripsit'} toxic={toxic} />
        <CompoundNameLink names={psychonaut_names} ids={null} site={'psychonaut'} toxic={toxic} />
        <CompoundNameLink names={isomerd_names} ids={isod_ids} site={'isomerdesign'} toxic={toxic} />
        <CompoundNameLink names={hsdb_names} ids={cid} site={'pubchem'} toxic={toxic} />
        <CompoundNameLink names={druglab_names} ids={druglab_href} site={'druglab'} toxic={toxic} />
        <CompoundNameLink names={drugmap_name} ids={drugmap_id} site={'drugmap'} toxic={toxic} />
    </>
}
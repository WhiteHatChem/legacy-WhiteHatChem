---
import Base from '../../layouts/Base.astro';
import Main from '../../layouts/Main.astro';
import CompoundSimilarities from '../../components/CompoundSimilarities.astro';
import CompoundNameLink from '../../components/CompoundNameLink.astro';
import TabGroup from '../../components/TabGroup';
import MoleculeViewer from '../../components/MoleculeViewer';
import ProteinAffinities from '../../components/ProteinAffinities.astro';
import type { MoleculeData } from '../../common/types';

export async function getStaticPaths({ paginate } : any) {
	const allNPS = await Astro.glob<MoleculeData>('../../../data/json/*.json');
    return allNPS.map((x) => ({
        params: { molecule: x.name },
        props: x
    }))
}

const {
  inchi, name,
  psychonaut_names,
  tripsit_names,
  isomerd_names, isod_ids,
  hsdb_names, cid,
  synonyms, svg,
  struct_sim, binding_sim, less_addictive_sim, binding_affinities
} = Astro.props as MoleculeData;

---

<style>
  li.active {
    display: block;
  }
  li:not(.active) {
    display: none;
  }
</style>

<Base title="Compounds.">
	<Main active="home">
        <section class="main-width mt-8">
            <div class="w-full flex flex-col items-center mb-8">
                <MoleculeViewer svg={svg} name={name} client:load/>
                <div class="flex flex-col text-xl gap-2">
                    <CompoundNameLink names={tripsit_names} ids={null} site={'tripsit'} />
                    <CompoundNameLink names={psychonaut_names} ids={null} site={'psychonaut'} />
                    <CompoundNameLink names={isomerd_names} ids={isod_ids} site={'isomerdesign'} />
                    <CompoundNameLink names={hsdb_names} ids={cid} site={'pubchem'} />
                    {
                        synonyms && synonyms.length > 0 && <p class="break-all leading-snug text-sm mt-4">
                            <span class="">Synonyms:</span>
                            <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">{synonyms.join(',')}</span>
                        </p>
                    }
                     <p class="break-all leading-snug text-sm mt-4">
                      <span class="">InChI:</span>
                      <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">{inchi}</span>
                  </p>
                </div>
            </div>
        </section>
        <section class="main-width flex flex-col items-left mt-16">
          <h2 class="font-bold text-2xl mb-8">Similarities</h2>
          <TabGroup
            client:load
            defaultActiveTab="struct"
            tabs={[
              { id: 'struct', label: 'Structural', available: struct_sim !== null },
              { id: 'affinity', label: 'Affinities', available: binding_affinities !== null },
            ]}
            tabsSelector="#similarities-tab-content>li"
          />
          <ul class="mt-4" id="similarities-tab-content">
            <li class="w-full flex flex-col active" id="struct">
                <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2 leading-snug">Most structurally similar compounds. The percentage is a measure of how structurally similar those molecules are, which is often strongly correlated with their effects.</span>
                <CompoundSimilarities sim={struct_sim} filter={x => Math.pow(Math.max(100-x, 0)/100, 4.)} />
            </li>
            <li class="w-full flex flex-col" id="affinity">
                <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">Similarities computed based on affinities of molecules with selected proteins docking site.</span>
                <div class="w-full pt-4" />
                <TabGroup
                  client:load
                  defaultActiveTab="dist_main"
                  tabs={[
                    { id: 'dist_main', label: 'Similar affinities', available: binding_sim !== null },
                    { id: 'dist_dopa', label: 'Similar dopaminergic affinities', available: less_addictive_sim !== null },
                    { id: 'profile', label: 'Affinities Profile', available: binding_affinities !== null },
                  ]}
                  tabsSelector="#nested-tab-content>li"
                />
                <ul class="mt-4" id="nested-tab-content">
                    {binding_sim && <li class="w-full flex flex-col active" id="dist_main">
                        <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">List of compounds which have the most similar docking sites affinities. The percentage is a measure of how similar the binding affinities of the molecules are, which should be a proxy to how similarly they interact with the brain.</span>
                        <CompoundSimilarities sim={binding_sim} filter={x => 1./(1.+Math.exp(-(x-144.)/52.))}/>
                    </li>}
                    {less_addictive_sim && <li class="w-full flex flex-col" id="dist_dopa">
                        <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">List of compounds which have the most similar docking sites affinities and have also high dopamine receptor interactions. This is thus a proxy to how much this molecule stimulates the dopamine receptors.</span>
                        <CompoundSimilarities sim={less_addictive_sim} filter={x => 1./(1.+Math.exp(-(x-563.)/298.))}/>
                    </li>}
                    {binding_affinities && <li class="w-full flex flex-col" id="profile">
                        <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">Binding affinities with a list of 34 predefined docking sites. Those affinities are used to compute the interactions similarities.</span>
                        <ProteinAffinities affinities={binding_affinities} />
                    </li>}
                </ul>
            </li>
          </ul>

        </section>
	</Main>
</Base>
---
import Base from '../../layouts/Base.astro';
import Main from '../../layouts/Main.astro';
import ComponentSvg from '../../components/ComponentSvg.astro'
import CompoundName from '../../components/CompoundName.astro';
import CompoundNameLink from '../../components/CompoundNameLink.astro';
import type { MoleculeData } from '../../common/types';

export async function getStaticPaths({ paginate } : any) {
	const allNPS = await Astro.glob<MoleculeData>('../../../data/json/*.json');
    return allNPS.map((x) => ({
        params: { molecule: x.name },
        props: x
    }))
}

const {
  inchi, name,
  psychonaut_names,
  tripsit_names,
  isomerd_names, isod_ids,
  hsdb_names, cid,
  synonyms, svg, sim
} = Astro.props as MoleculeData;
---

<Base title="Compounds.">
	<Main active="home">
        <section class="main-width mt-8">
            <div class="w-full flex flex-col items-center mb-8">
                { svg && <ComponentSvg svg={svg} name={name}/> }
                <div class="flex flex-col text-xl gap-2">
                    <CompoundNameLink names={tripsit_names} ids={null} site={'tripsit'} />
                    <CompoundNameLink names={psychonaut_names} ids={null} site={'psychonaut'} />
                    <CompoundNameLink names={isomerd_names} ids={isod_ids} site={'isomerdesign'} />
                    <CompoundNameLink names={hsdb_names} ids={cid} site={'pubchem'} />
                    {
                        synonyms && synonyms.length > 0 && <p class="break-all leading-snug text-sm mt-4">
                            <span class="">Synonyms:</span>
                            <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">{synonyms.join(',')}</span>
                        </p>
                    }
                     <p class="break-all leading-snug text-sm mt-4">
                      <span class="">InChI:</span>
                      <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">{inchi}</span>
                  </p>
                </div>
            </div>

            <div class="w-full flex flex-col items-center mt-16">
                <div class="w-full max-w-2xl flex flex-col">
                    <span class="text-xl font-bold">Most structurally similar compounds:</span>
                    <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">The percentage is a metric of how structurally similar those molecules are, which is often strongly correlated with their effects. Take these informations with a grain of salt for now we are improving our methods to analyse molecules. We will provide more information on how those similarities are computed later</span>
                    <div class="flex flex-col mt-4 gap-2">
                        { sim.map((x) => {
                            const sim = Math.pow(Math.max(100-x.dist, 0)/100, 4.);
                            const green = Math.round(255 * sim);
                            const red = Math.round(255 * (1-sim));
                            return <a href={`/molecule/${x.name}`} class="flex lg:flex-row flex-col gap-2 items-center justify-between min-h-16 border dark:border-neutral-600 rounded p-2">
                                <div class="flex flex-col">
                                    {x.psychonaut_names && x.psychonaut_names.map(name => <CompoundName name={name} site="psychonaut"/>)}
                                    {x.tripsit_names && x.tripsit_names.map(name => <CompoundName name={name} site="tripsit"/>)}
                                    {x.isomerd_names && x.isomerd_names.map(name => <CompoundName name={name} site="isomerdesign"/>)}
                                </div>
                                <span class="flex items-center w-full lg:w-min">
                                    <p class="text-sm text-neutral-600 dark:text-neutral-400 text-sm mr-2">{`${(Math.round(sim * 1000) / 10).toFixed(1)}%`}</p>
                                    <div class="w-full lg:w-60 h-5 bg-neutral-200 dark:bg-neutral-700 rounded border border-neutral-300 dark:border-neutral-600 overflow-hidden">
                                        <div
                                            class="h-full rounded text-xs"
                                            style={{
                                                width: `${100 * sim}%`,
                                                backgroundColor: `rgb(${red}, ${green}, 0)`,
                                            }}
                                        />
                                    </div>
                                </span>
                            </a>
                        }) }
                    </div>
                </div>
            </div>
        </section>
	</Main>
</Base>
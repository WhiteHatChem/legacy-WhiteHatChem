---
import Base from '../../layouts/Base.astro';
import Main from '../../layouts/Main.astro';

import screenshot from '../../assets/img/website_screen.png'
import { Lang, i18n_href, languagesList, useTranslations } from '../../i18n/i18n';
import { WLink } from '../../components/components';

export const prerender = true;

export async function getStaticPaths() {
  return languagesList.map((lang) => ({
    params: { lang: lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Base title="WhiteHatChemistry (WHC)">
	<Main>
		<main>
			<section class="
				flex flex-col items-center
				main-width text-center
				py-28 lg:py-40
			">
				<h1 class="text-5xl lg:text-6xl max-w-4xl font-bold tracking-tight">
					{t('home.hero1')} <span class="text-indigo-400">{t('home.hero2')}</span> {t('home.hero3')}.
				</h1>
				<p class="text-normal lg:text-lg max-w-2xl text-neutral-600 dark:text-neutral-400 mt-6">
					{t('home.mission')}
				</p>
				<div class="mt-10 flex flex-col items-center">
          		<div class="flex items-center">
					<a
						href={i18n_href('/discover', lang)}
						class="py-1 px-3 rounded-xl text-white dark:text-black bg-indigo-400 hover:bg-indigo-600 dark:bg-indigo-400 dark:hover:bg-indigo-200 transition duration-150"
					>
						{t('home.latest')}
					</a>
					<a
						href={i18n_href('/reachus', lang)}
						class="
							py-1 px-3 ml-2
							rounded-xl text-neutral-600 dark:text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200
							border border-2 border-neutral-200 dark:border-neutral-600 hover:border-neutral-400 dark:hover:border-neutral-400
							transition duration-150
						"
					>
						{t('home.reachus')}
					</a>
				</div>
          <a
            href="https://discord.gg/SKGhEsWT7R"
            class="
              py-1 px-3 mt-2
              text-neutral-600 hover:text-neutral-800
              dark:text-neutral-400 dark:hover:text-neutral-200              
              underline hover:decoration-2
              flex flex-row items-center gap-1
            "
          >
		  	{t('home.discord')}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 127.14 96.36"
              fill="currentColor"
              class="w-4 h-4"
            >
              <g id="图层_2" data-name="图层 2">
              <g id="Discord_Logos" data-name="Discord Logos">
                <g id="Discord_Logo_-_Large_-_White" data-name="Discord Logo - Large - White">
                <path class="cls-1" d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
                </g>
              </g>
              </g>
            </svg>
          </a>
				</div>
			</section>

			<section
				id="mission"
				class="
					pt-28 lg:pt-32 overflow-hidden
					bg-gradient-to-b from-transparent via-fuchsia-100/30 to-indigo-100/50
					dark:from-transparent dark:via-transparent dark:to-transparent
					flex justify-center
					px-4
				"
			>
				<div class="grid lg:grid-cols-3 gap-y-8 lg:gap-x-16">
					<div class="flex flex-col gap-6 justify-center lg:w-96">
						<h1 class="text-xl lg:text-xl font-bold text-neutral-800 dark:text-neutral-200 lg:max-w-4xl flex flex-col">
							<span>{t('home.sent1')}</span>
							<span>{t('home.sent2')}</span>
						</h1>
						<p class="text-neutral-600 dark:text-neutral-400 leading-snug">
							{t('home.sent3')}
						</p>
						<a
							href={i18n_href('/discover', lang)}
							class="text-neutral-800 hover:text-neutral-400 dark:text-neutral-200 dark:hover:text-neutral-400 underline underline-offset-4"
						>
							{t('home.explore')}
						</a>
					</div>
					<div class="lg:col-span-2 relative max-w-[800px]">
						<img
							src={screenshot}
							class="rounded-t-xl shadow-lg border border-b-0"
							alt="WhiteHatChemistry screenshot"
						>
					</div>
				</div>
			</section>

			<section class="
				border-t border-b border-neutral-200 dark:border-neutral-600
				py-28 lg:py-24
			">
				<div class="main-width text-justify flex flex-col gap-8">
					<h2 class="text-xl lg:text-xl font-bold text-neutral-800 dark:text-neutral-200 text-center">
						{t('home.why')}
					</h2>
					<p class="text-neutral-600 dark:text-neutral-400 leading-snug text-center">
						{t('home.sent4')}
					</p>
				</div>
			</section>

			<section class="
				pt-28 lg:pt-32 overflow-hidden
				bg-gradient-to-t from-transparent via-fuchsia-100/30 to-indigo-100/50
				dark:from-transparent dark:via-transparent dark:to-transparent
				flex justify-center
			">
        <div class="main-width grid grid-cols-3">
          <div class="px-4 border-r dark:border-neutral-800">
            <svg class="w-12 h-12 mb-4 text-indigo-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31"/><path d="M14 9.3V1.99"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><path d="M5.52 16h12.96"/></svg>
            <div class="font-semibold mb-2">Compound Analysis API</div>
            <p class="leading-snug text-neutral-800 dark:text-neutral-200">Our <WLink href="/api">powerful API</WLink> allows seamless integration of your systems to analyze your own compounds. Leveraging advanced deep-learning models, we offer rapid and accurate analysis that can streamline your research and reduce time to discovery.</p>
          </div>
          <div class="px-4 border-r dark:border-neutral-800">
            <svg class="w-12 h-12 mb-4 text-indigo-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /> </svg>
            <div class="font-semibold mb-2">Reliable NPS Database</div>
            <p class="leading-snug text-neutral-800 dark:text-neutral-200">Gain access to our <WLink href="/api">comprehensive database</WLink> of NPS molecules, meticulously compiled and continually updated. This resource provides extensive information on molecular properties, toxicity, metabolism, and more, serving as a valuable foundation for your research.</p>
          </div>
          <div class="mx-4">
            <svg class="w-12 h-12 mb-4 text-indigo-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M2 12C2 6.5 6.5 2 12 2a10 10 0 0 1 8 4"/><path d="M5 19.5C5.5 18 6 15 6 12c0-.7.12-1.37.34-2"/><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M2 16h.01"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M9 6.8a6 6 0 0 1 9 5.2c0 .47 0 1.17-.02 2"/></svg>
            <div class="font-semibold mb-2">Spectral Identification</div>
            <p class="leading-snug text-neutral-800 dark:text-neutral-200">Our innovative spectral identification tool uses machine learning algorithms to swiftly and reliably identify compounds, through robust prediction of their infrared spectra</p>
          </div>
        </div>
			</section>

      <section class="flex flex-col items-center main-width px-16 pt-32 lg:pt-36 mb-48">
        <h1 class="font-bold text-3xl text-center">Get started with us today and gain access to our extensive database and tools for a safer and more informed approach to NPS.</h1>
        <p class="pt-8 text-xl text-center">Have questions, suggestions, or need more information about our services? <br/> We'd love to hear from you.</p>
        <a
          class="mt-8 rounded-lg bg-indigo-400 dark:bg-indigo-600 px-6 py-3 text-white font-bold text-xl"
          target="_blank"
          href="mailto:whitehatchem@gmail.com"
        >
          Reach us
        </a>
      </section>

		</main>
	</Main>
</Base>
---
import Base from '../../../layouts/Base.astro';
import Main from '../../../layouts/Main.astro';
import { CompoundCard } from '../../../components/compound';
import { ErrorMessage } from '../../../components/error';
import type { MoleculeData } from '../../../common/types';
import { Lang, languagesList, useTranslations, i18n_href } from '../../../i18n/i18n';
import { postSearch } from '../../../common/api';
import { SearchBox } from '../../../components/search';

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const search = Astro.url.searchParams.get('q') || '';
const page = parseInt(Astro.url.searchParams.get('p') || '0');

const result = await postSearch(search, page);
---

<Base title={search === "" ? `Search compounds`: `Results for ${search}` }>
	<Main>
    <section class="main-width mt-8">
      {/*<h1 class="
        font-bold text-3xl mb-10
        text-center lg:text-left
      ">
        {t('search_nps')}
      </h1>*/}

      <SearchBox search={search} lang={lang} discover/>

      {result._type === 'data' ? (() => {
        let { data, done }= result.data;

        const previousPage = (page > 0) ? (page - 1) : null;
        const nextPage = done ? null : page + 1;

        const previousHref = (previousPage !== null) ? i18n_href(`/search?q=${search}&p=${previousPage}`, lang) : null;
        const nextHref = (nextPage !== null) ? i18n_href(`/search?q=${search}&p=${nextPage}`, lang) : null;

        const no_results = data.length === 0;
        return (
          no_results ? <div class="h-36">
            <p class="text-center italic text-neutral-400 dark:text-neutral-400/60">Example: alcohol, LSD, H4-CBD, 2cb-fly, ...</p>
          </div> : <>
            <!-- NPS grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 lg:gap-16 gap-8 items-end">
              {
                data.map((x: MoleculeData) => <>
                  <CompoundCard data={x} _id={x._id} lang={lang}/>
                </>)
              }
            </div>

            <!-- Page selection -->
            <div class="flex gap-4 justify-center w-full lg:mt-12 mt-10">
              {previousHref ? <a href={previousHref}>{previousPage}</a> : null}
              <p class="font-bold px-2 text-white bg-indigo-400 rounded-full"> {page} </p>
              {nextHref ? <a href={nextHref}>{nextPage}</a> : null}
            </div>
          </>
        )
      })() : <ErrorMessage message="Couldn't fetch data" log={result.m} />}
    </section>
	</Main>
</Base>
---
import Base from '../../layouts/Base.astro';
import Main from '../../layouts/Main.astro';
import { Lang, languagesList, useTranslations, i18n_href } from '../../i18n/i18n';

export async function getStaticPaths() {
  return languagesList.map((lang) => ({
    params: { lang: lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<style>
  h1 {
    font-size: 2rem;
    margin-top: 2rem;
  }
  p {
    margin-top: 1rem;
  }
</style>

<Base title="Reach us">
	<Main>
    <section class="main-width">
      <h1>{t('reachus.reachus')}</h1>
      <p>{t('reachus.sent1')}</p>

      <h1>{t('reachus.api')}</h1>
      <p>{t('reachus.sent2')} <a class="underline" href='/api'>{t('reachus.sent5')}</a></p>

      <h1>{t('reachus.database')}</h1>
      <p>SOON</p>

      <h1>{t('reachus.contactus')}</h1>
      <p> {t('reachus.sent3')} <a class="underline" href="mailto:whitehatchem@gmail.com">whitehatchem@gmail.com</a>. {t('reachus.sent4')}</p>
    </section>
	</Main>
</Base>
---
import Base from '../../../layouts/Base.astro';
import Main from '../../../layouts/Main.astro';
import CompoundSimilarities from '../../../components/CompoundSimilarities.astro';
import TabGroup from '../../../components/TabGroup';
import Reaction from '../../../components/Reaction.astro';
import MoleculeViewer from '../../../components/MoleculeViewer';
import ProteinAffinities from '../../../components/ProteinAffinities.astro';
import { languagesList, useTranslations, Lang, i18n_href } from '../../../i18n/i18n';
import type { MoleculeData } from '../../../common/types';
import CompoundNameLinks from '../../../components/compound_id/CompoundNameLinks.astro';

export async function getStaticPaths() {
	const allNPS = await Astro.glob<MoleculeData>('../../../../data/json/*.json');
  return languagesList.map((lang) => (
    allNPS.map((x) => ({
      params: { molecule: x.id.name, lang: lang },
      props: x
    }))
  )).flat()
}

const { molecule, lang } = Astro.params as { molecule: string, lang: Lang };
const t = useTranslations(lang);

const {
  id,
  market_name,
  synonyms,
  struct_sim, binding_sim, less_addictive_sim, less_addictive_predictive_sim, binding_affinities,
  solubility, solubility_comment,
  metabolism,
	chemograph,
	clintox_pred, recursive_toxicity, addictive_prediction, bbb_permeability,
} = Astro.props as MoleculeData;

const {
  inchi, name, svg,
  psychonaut_names,
  tripsit_names,
  isomerd_names,
  isod_ids,
  druglab_names, druglab_href,
  hsdb_names, cid,
  search, toxic, metabolite,
} = id;

const default_sim = (
  (struct_sim !== null) ? 'struct' :
  (binding_sim !== null || less_addictive_sim !== null || binding_affinities !== null) ? 'affinity' :
  (metabolism !== null) ? 'metabolism' :
  null
);
---

<Base title="Compounds.">
	<Main>
        <section class="main-width mt-8">
            <div class="w-full flex flex-col items-center mb-8">
                <MoleculeViewer svg={svg} inchi={inchi} client:load/>
                <div class="flex flex-col text-xl gap-2">
                    <CompoundNameLinks id={id} />

                    <p class="text-center mt-4">Data</p>
                    <p class="break-all leading-snug text-sm">
                      <span class="">InChI:</span>
                      <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">{inchi}</span>
                    </p>
                    {
                        synonyms && synonyms.length > 0 && <p class="break-all leading-snug text-sm">
                            <span class="">{t('molecule.synonyms')}:</span>
                            <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">{synonyms.join(',')}</span>
                        </p>
                    }
                    {
                        market_name && <p class="break-all leading-snug text-sm">
                            <span class="">{t('molecule.market')}:</span>
                            <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">{market_name}</span>
                        </p>
                    }

                    {
                    }
                    <hr/>
                    <p class="text-center mt-4">Estimated data</p>
                    {
                      solubility && <p class="break-all leading-snug text-sm">
                          <span class="">{t('molecule.solubility')}:</span>
                          <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">
                            {solubility}{solubility_comment ? ` (${solubility_comment})` : ''} (log(S) in mol/L prediction using <a class="underline" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8900744/">SolTranNet</a>)
                          </span>
                      </p>
                    }
                    {
                      clintox_pred !== null && <p class="break-all leading-snug text-sm">
                          <span class="">{t('molecule.clintox')}:</span>
                          <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">
                            {(clintox_pred*100).toFixed(1)}% (prediction using <a class="underline" href="https://www.nature.com/articles/s41598-023-31169-8">nature.com</a> with MTDNN-SE_ClinTox+Tox21 model)
                          </span>
                      </p>
                    }
                    {
                      recursive_toxicity !== null && <p class="break-all leading-snug text-sm">
                          <span class="">{t('molecule.rectoxicity')}:</span>
                          <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">
                            {(recursive_toxicity*100).toFixed(1)}% (toxicity predicted using the toxicity of metabolites recursively up to order two, prediction using <a class="underline" href="https://www.nature.com/articles/s41598-023-31169-8">nature.com</a>)
                          </span>
                      </p>
                    }
                    {
                      bbb_permeability !== null && <p class="break-all leading-snug text-sm">
                          <span class="">{t('molecule.bbbpermeability')}:</span>
                          <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">
                            {bbb_permeability ? "Yes" : "No"} (prediction using <a class="underline" href="https://www.frontiersin.org/articles/10.3389/fnins.2022.858126/full">frontiersin.org</a>)
                          </span>
                      </p>
                    }
                    {
                      addictive_prediction !== null && <p class="break-all leading-snug text-sm">
                          <span class="">{t('molecule.addictiveprediction')}:</span>
                          <span class="font-gray font-light text-neutral-800 dark:text-neutral-200">
                            {(addictive_prediction*100).toFixed(1)}% (prediction based on <a class="underline" href="https://www.mdpi.com/1420-3049/27/12/3931">www.mdpi.com</a>)
                          </span>
                      </p>
                    }
                </div>
            </div>
        </section>
        <section class="main-width flex flex-col items-left mt-16">
          <h2 class="font-bold text-2xl mb-6">{t('molecule.similarities')}</h2>
          <p class="text-neutral-800 dark:text-neutral-200 leading-snug mb-4">
            {t('molecule.sent10')}
            <a class="underline" href={i18n_href('/blog', lang)}>{t('molecule.sent11')}</a>
            {t('molecule.sent12')}
            <b>{t('molecule.sent13')}</b>
          </p>
          {
            default_sim !== null ?
            <TabGroup
              client:load
              defaultActiveTab={default_sim}
              tabs={[
                { id: 'struct', label: t('molecule.structural'), available: struct_sim !== null },
                { id: 'affinity', label: t('molecule.affinities'), available: binding_affinities !== null },
                { id: 'metabolism', label: t('molecule.metabolism'), available: metabolism !== null },
              ]}
              tabsSelector="#similarities-tab-content>li"
            />
            <ul class="mt-4" id="similarities-tab-content">
              <li class="w-full flex flex-col active" id="struct">
                  <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2 leading-snug">{t('molecule.sent1')}</span>
                  <div class="w-full pt-4" />
                  <TabGroup
                    client:load
                    defaultActiveTab="struct_main"
                    tabs={[
                      { id: 'struct_main', label: t('molecule.struct_tab1'), available: struct_sim !== null },
                      { id: 'struct_dopa', label: t('molecule.struct_tab2'), available: less_addictive_predictive_sim !== null },
                    ]}
                    tabsSelector="#struct-tab-content>li"
                  />
                  <ul class="mt-4" id="struct-tab-content">
                      {struct_sim && <li class="w-full flex flex-col active" id="struct_main">
                          <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">{t('molecule.sent15')}</span>
                          <CompoundSimilarities sim={struct_sim} filter={x => 1/(1+Math.pow(x, -0.5))} />
                      </li>}
                      {less_addictive_predictive_sim && <li class="w-full flex flex-col" id="struct_dopa">
                          <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">{t('molecule.sent16')}</span>
                          <CompoundSimilarities sim={less_addictive_predictive_sim} filter={x => 1/(1+Math.pow(x, -0.5))}/>
                      </li>}
                  </ul>
              </li>
              <li class="w-full flex flex-col" id="affinity">
                  <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">{t('molecule.sent3')}</span>
                  <div class="w-full pt-4" />
                  <TabGroup
                    client:load
                    defaultActiveTab="dist_main"
                    tabs={[
                      { id: 'dist_main', label: t('molecule.aff_tab1'), available: binding_sim !== null },
                      { id: 'dist_dopa', label: t('molecule.aff_tab2'), available: less_addictive_sim !== null },
                      { id: 'profile', label: t('molecule.aff_tab3'), available: binding_affinities !== null },
                    ]}
                    tabsSelector="#nested-tab-content>li"
                  />
                  <ul class="mt-4" id="nested-tab-content">
                      {binding_sim && <li class="w-full flex flex-col active" id="dist_main">
                          <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">{t('molecule.sent4')}</span>
                          <CompoundSimilarities sim={binding_sim} filter={x => 1/(1+Math.pow(x, -0.5))}/>
                      </li>}
                      {less_addictive_sim && <li class="w-full flex flex-col" id="dist_dopa">
                          <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">{t('molecule.sent5')}</span>
                          <CompoundSimilarities sim={less_addictive_sim} filter={x => 1/(1+Math.pow(x, -0.5))}/>
                      </li>}
                      {binding_affinities && <li class="w-full flex flex-col" id="profile">
                          <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">{t('molecule.sent6')}</span>
                          <ProteinAffinities affinities={binding_affinities} />
                      </li>}
                  </ul>
              </li>
              <li class="w-full flex flex-col" id="metabolism">
                  <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2 leading-snug">{t('molecule.sent7')} <a href="https://biotransformer.ca/about">?</a></span>
                  {metabolism && metabolism.anterior && <div>
                    <div class="my-4 text-lg">{t('molecule.sent8')}</div>
                    <div class="flex flex-col gap-2">
                      {metabolism.anterior.map(x => <Reaction reaction={x}/>)}
                    </div>
                  </div>}
                  {metabolism && metabolism.anterior && <div>
                    <div class="my-4 text-lg">{t('molecule.sent9')}</div>
                    <div class="flex flex-col gap-2">
                      {metabolism.anterior.map(x => <Reaction reaction={x}/>)}
                    </div>
                  </div>}
              </li>
            </ul>
            : <span class="text-neutral-600 dark:text-neutral-400 text-sm mt-2">{t('molecule.no_sim')}</span>
          }
        </section>
	</Main>
</Base>
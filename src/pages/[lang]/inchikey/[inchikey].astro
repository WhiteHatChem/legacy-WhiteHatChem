---
import Base from '../../../layouts/Base.astro';
import Main from '../../../layouts/Main.astro';
import { CompoundCard } from '../../../components/compound'
import { languagesList, useTranslations, Lang, i18n_href } from '../../../i18n/i18n';
import type { MoleculeData } from '../../../common/types';
import { getMoleculeByInchikey } from '../../../common/api';

const { inchikey, lang } = Astro.params as { inchikey: string, lang: Lang };
const t = useTranslations(lang);

const data = await getMoleculeByInchikey(inchikey);

console.log(data)
---

<Base title="Compounds">
	<Main>
    <section class="main-width">
      <h1 class="
        font-bold text-4xl mb-20
        text-center lg:text-left
      ">
        {t('nps')}
      </h1>

      <!-- NPS grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 lg:gap-16 gap-8">
        {
          data.map((x: MoleculeData) =>
            <CompoundCard data={x} lang={lang}/>
          )
        }
      </div>
    </section>
	</Main>
</Base>
---
import Base from '../../layouts/Base.astro';
import Main from '../../layouts/Main.astro';

const blogs = await Astro.glob('./*.mdx');
---

<Base title="Blog">
	<Main active="home">

    <section class="main-width">
      <h1 class="text-4xl font-bold mb-8">Blog</h1>
      <p class="text dark:text-neutral-200">
        Here you will find a collection of informative and interesting articles on a variety of topics related to our latest findings for WHC.
      </p>
      <div class="flex flex-col">
        {
          blogs.map(blog => (
            <a
              class="
                rounded-xl mx-2 my-4 py-4 px-8 border dark:border-neutral-600
                hover:bg-indigo-50 hover:border-indigo-200
                dark:hover:bg-indigo-900/50 dark:hover:border-indigo-600
              "
              href={blog.url}
            >
              <h2 class="text-xl mb-2 font-bold">{blog.frontmatter.title}</h2>
              <div class="flex flex-row gap-2">
                <p class="dark:text-neutral-300 text-neutral-600">{blog.frontmatter.author}</p>
                <p class="text-gray-500">{blog.frontmatter.date}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
	</Main>
</Base>